# Copy to secrets.yaml (gitignored) next to the unit YAMLs.
wifi_ssid: "your-network"
wifi_password: "your-wifi-password"
fallback_password: "fallback-ap-password"
ota_password: "ota-password"
# 32 random bytes, base64: openssl rand -base64 32
api_key: "base64-api-key"

# One per device. Settings shows a token once when you add or rotate a unit.
# Key is token_ + the ESPHome node name with - replaced by _.
token_great_room: "device-token"
