# Copy this file to secrets.yaml in the same folder (or paste these
# keys into ESPHome → Secrets). Do not commit secrets.yaml.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Used if the board can't join Wi-Fi. Must be at least 8 characters.
fallback_password: "changeme8"

# Generate with: openssl rand -base64 32
api_key: "paste-32-byte-base64-here"
ota_password: "changeme-ota"
